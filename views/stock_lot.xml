<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_production_lot_form_inherit_equipment" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.equipment</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Medical Equipment Details">
                    <field name="equipment_status" widget="selection"/>
                    <field name="total_runing_hours"/>
                    <field name="department_id"/>
                    <field name="is_locked_for_so"/>
                </group>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Meter Logs">
                        <field name="meter_log_ids">
                            <list string="Meter Logs">
                                <field name="reading_date"/>
                                <field name="current_meter_reading"/>
                                <field name="running_hours_added"/>
                                <field name="recorded_by"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>