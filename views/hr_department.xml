<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_department_form_inherit_equipment" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.equipment</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Medical Equipment &amp; Assets">
                        <field name="equipment_lot_ids" mode="list">
                            <list string="Equipment">
                                <field name="name"/>
                                <field name="product_id"/>
                                <field name="equipment_status"/>
                                <field name="total_runing_hours"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>